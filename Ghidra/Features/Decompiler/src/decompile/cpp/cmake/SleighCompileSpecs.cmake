# ghidra_sleigh_compile_specs: compile processor specifications into a
# "sleigh home" directory tree.
#
#   ghidra_sleigh_compile_specs(
#     TARGET <name>                 custom target that builds every .sla
#     PROCESSORS <p1;p2;...>        directory names under PROCESSORS_ROOT
#     OUTPUT_DIR <dir>              root of the generated tree
#     [PROCESSORS_ROOT <dir>]       default: Ghidra/Processors of this checkout
#     [COMPILER <target-or-path>]   default: sleigh_compiler target
#     [OUT_VAR <var>]               receives the list of generated .sla files
#   )
#
# Layout produced, which SleighArchitecture::scanForSleighDirectories walks:
#
#   <OUTPUT_DIR>/Ghidra/Processors/<P>/data/languages/<spec>.sla
#   <OUTPUT_DIR>/Ghidra/Processors/<P>/data/languages/<support files>
#
# Only .slaspec files that some .ldefs in the same directory names in a
# slafile="..." attribute are compiled.  Support files are every regular file
# in data/languages that is not .slaspec, .sinc or .sla (that is: .ldefs,
# .pspec, .cspec, .opinion, .dwarf, .gdis, .register.info, ...).
#
# OUTPUT_DIR must be empty or previously generated by this function (it
# contains an identity-bearing .sleigh-home-owned-by-cmake marker); files this
# build generated earlier and no longer owns are removed on reconfigure.
#
# Per-processor compiler options come from sleighCompileOptions in
# <PROCESSORS_ROOT>/<P>/build.gradle, the same source the Gradle build uses.
# Only a standalone literal-list assignment is supported. The target property
# GHIDRA_SLEIGH_INSTALLABLE_FILES lists absolute owned spec/support paths.
#
# Each .slaspec is compiled in single-file mode with an explicit output path,
# so @include resolves against the source tree and the source tree stays
# clean.  Compilation runs in the Ninja job pool named `sleigh_specs`
# (property JOB_POOLS on the global scope); set it before calling this
# function to bound parallelism.  x86-64 and AARCH64 each take minutes and
# more than 1 GB of memory.


# Only literal option lists are supported, not general Groovy evaluation.
# Consume quoted strings and comments together so comment delimiters inside
# ordinary quoted strings are not mistaken for comments.
# Inspect interpolation lexically, without evaluating Groovy. Only ordinary
# double-quoted strings are handled here. A nested double-quoted expression
# cannot be tokenized by this small lexer and is rejected explicitly.
function(_ghidra_sleigh_interpolation _token _gradle _present _references)
  set(_has FALSE)
  set(_code)
  if(_token MATCHES "^\"")
    string(LENGTH "${_token}" _length)
    math(EXPR _end "${_length} - 1")
    set(_index 1)
    set(_depth 0)
    set(_single_quote FALSE)
    while(_index LESS _end)
      string(SUBSTRING "${_token}" ${_index} 1 _char)
      if(_char STREQUAL "\\")
        if(_depth GREATER 0 AND NOT _single_quote)
          message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported escape in sleighCompileOptions interpolation scan")
        endif()
        # Skip a complete escape pair: \$ is literal; \\$ still interpolates.
        math(EXPR _index "${_index} + 2")
        continue()
      endif()
      if(_depth GREATER 0)
        if(_single_quote)
          if(_char STREQUAL "'")
            set(_single_quote FALSE)
          endif()
          string(APPEND _code " ")
        elseif(_char STREQUAL "'")
          set(_single_quote TRUE)
          string(APPEND _code " ")
        elseif(_char STREQUAL "\"")
          message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported nested string in sleighCompileOptions interpolation scan")
        elseif(_char STREQUAL "/")
          # Slashy strings/comments could hide braces. Distinguishing them
          # from division needs Groovy grammar, so do not guess here.
          message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported slash syntax in sleighCompileOptions interpolation scan")
        elseif(_char STREQUAL "{")
          math(EXPR _depth "${_depth} + 1")
          string(APPEND _code " ")
        elseif(_char STREQUAL "}")
          math(EXPR _depth "${_depth} - 1")
          string(APPEND _code " ")
        else()
          string(APPEND _code "${_char}")
        endif()
      elseif(_char STREQUAL "$")
        set(_has TRUE)
        string(SUBSTRING "${_token}" ${_index} -1 _tail)
        if(_tail MATCHES "^\\$\\{")
          set(_depth 1)
          math(EXPR _index "${_index} + 1")
        elseif(_tail MATCHES "^\\$([A-Za-z_$][A-Za-z0-9_$.]*)")
          string(APPEND _code " ${CMAKE_MATCH_1} ")
          string(LENGTH "${CMAKE_MATCH_0}" _matched_length)
          math(EXPR _index "${_index} + ${_matched_length} - 1")
        else()
          message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported dollar form in sleighCompileOptions interpolation scan")
        endif()
      endif()
      math(EXPR _index "${_index} + 1")
    endwhile()
    if(NOT _depth EQUAL 0 OR _single_quote)
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported or unclosed string in sleighCompileOptions interpolation scan")
    endif()
  endif()
  set(${_present} "${_has}" PARENT_SCOPE)
  set(${_references} "${_code}" PARENT_SCOPE)
endfunction()

function(_ghidra_sleigh_options _gradle _result)
  file(READ "${_gradle}" _remaining)
  set(_active)
  set(_executable)
  set(_lexeme [=["([^"\\]|\\.)*"|'([^'\\]|\\.)*'|//[^\r\n]*|/\*([^*]|\*+[^*/])*\*+/]=])
  string(REPLACE "\\r" "\r" _lexeme "${_lexeme}")
  string(REPLACE "\\n" "\n" _lexeme "${_lexeme}")
  while(_remaining MATCHES "${_lexeme}")
    set(_token "${CMAKE_MATCH_0}")
    string(FIND "${_remaining}" "${_token}" _start)
    string(SUBSTRING "${_remaining}" 0 ${_start} _prefix)
    string(APPEND _active "${_prefix}")
    string(APPEND _executable "${_prefix}")
    if(_token MATCHES "^/")
      string(APPEND _active " ")
      string(APPEND _executable " ")
    else()
      _ghidra_sleigh_interpolation("${_token}" "${_gradle}" _interpolated _references)
      if(_references MATCHES "(^|[^A-Za-z0-9_$])sleighCompileOptions([^A-Za-z0-9_$]|$)")
        message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported executable interpolation of sleighCompileOptions")
      endif()
      string(APPEND _active "${_token}")
      # Keep offsets/newlines aligned with _active while excluding literal
      # string contents from the executable-reference check below.
      string(REGEX REPLACE "[^\r\n]" " " _masked "${_token}")
      string(APPEND _executable "${_masked}")
    endif()
    string(LENGTH "${_token}" _length)
    math(EXPR _end "${_start} + ${_length}")
    string(SUBSTRING "${_remaining}" ${_end} -1 _remaining)
  endwhile()
  string(APPEND _active "${_remaining}")
  string(APPEND _executable "${_remaining}")
  set(_options)
  if(_active MATCHES "(^|[\r\n])[ \t]*sleighCompileOptions[ \t\r\n]*=")
    string(REGEX MATCH "(^|[\r\n])[ \t]*sleighCompileOptions[ \t\r\n]*=[ \t\r\n]*\\[([^]]*)\\]" _assignment "${_active}")
    if(NOT _assignment)
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: expected literal sleighCompileOptions list")
    endif()
    set(_list "${CMAKE_MATCH_2}")
    string(FIND "${_active}" "${_assignment}" _start)
    string(LENGTH "${_assignment}" _length)
    math(EXPR _end "${_start} + ${_length}")
    string(SUBSTRING "${_active}" ${_end} -1 _tail)
    string(SUBSTRING "${_executable}" 0 ${_start} _code_before)
    string(SUBSTRING "${_executable}" ${_end} -1 _code_after)
    set(_executable "${_code_before}${_code_after}")
    if(NOT _tail MATCHES "^[ \t]*;?[ \t]*([\r\n]|$)" OR
       _tail MATCHES "(^|[\r\n])[ \t]*sleighCompileOptions[ \t\r\n]*=")
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: expected one standalone literal sleighCompileOptions assignment")
    endif()
    # Literal flags may use either quote style and an optional trailing comma.
    while(TRUE)
      string(STRIP "${_list}" _list)
      if(_list STREQUAL "")
        break()
      endif()
      if(NOT _list MATCHES "^('[^';]*'|\"[^\";]*\")")
        message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported sleighCompileOptions expression")
      endif()
      set(_quoted "${CMAKE_MATCH_0}")
      string(LENGTH "${_quoted}" _length)
      math(EXPR _value_length "${_length} - 2")
      string(SUBSTRING "${_quoted}" 1 ${_value_length} _value)
      _ghidra_sleigh_interpolation("${_quoted}" "${_gradle}" _interpolated _references)
      if(_interpolated)
        message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported computed sleighCompileOptions value")
      endif()
      if(_quoted MATCHES "^\"")
        string(REPLACE "\\$" "$" _value "${_value}")
      endif()
      if(_value MATCHES "\\\\")
        message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported escape in sleighCompileOptions value")
      endif()
      list(APPEND _options "${_value}")
      string(SUBSTRING "${_list}" ${_length} -1 _list)
      string(STRIP "${_list}" _list)
      if(_list STREQUAL "")
        break()
      elseif(_list MATCHES "^,")
        string(SUBSTRING "${_list}" 1 -1 _list)
      else()
        message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: expected comma in sleighCompileOptions")
      endif()
    endwhile()
  endif()
  # Every executable use except the supported assignment is unsupported:
  # +=, <<, method calls, aliases and unsupported-only definitions included.
  if(_executable MATCHES "(^|[^A-Za-z0-9_$])sleighCompileOptions([^A-Za-z0-9_$]|$)")
    message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_gradle}: unsupported executable use of sleighCompileOptions")
  endif()
  set(${_result} "${_options}" PARENT_SCOPE)
endfunction()

# Resolve existing ancestors too, including a not-yet-created output directory
# below a symlink. Store canonical paths in both ownership files.
function(_ghidra_sleigh_real_path _path _result)
  get_filename_component(_absolute "${_path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
  # EXISTS follows links and is false for a dangling link. Check the link
  # itself before reconstructing a missing path from its parent; recursion
  # also catches dangling directory components of not-yet-created outputs.
  if(IS_SYMLINK "${_absolute}" AND NOT EXISTS "${_absolute}")
    message(FATAL_ERROR "ghidra_sleigh_compile_specs: refusing dangling symlink: ${_absolute}")
  endif()
  if(EXISTS "${_absolute}")
    get_filename_component(_canonical "${_absolute}" REALPATH)
  else()
    get_filename_component(_parent "${_absolute}" DIRECTORY)
    get_filename_component(_name "${_absolute}" NAME)
    _ghidra_sleigh_real_path("${_parent}" _canonical_parent)
    set(_canonical "${_canonical_parent}/${_name}")
  endif()
  set(${_result} "${_canonical}" PARENT_SCOPE)
endfunction()

function(_ghidra_sleigh_check_home _home _identity _previous)
  set(_marker "${_home}/.sleigh-home-owned-by-cmake")
  if(IS_SYMLINK "${_marker}")
    message(FATAL_ERROR "ghidra_sleigh_compile_specs: refusing symlink ownership marker: ${_marker}")
  endif()
  if(EXISTS "${_marker}")
    file(READ "${_marker}" _owner)
    if(_owner STREQUAL "")
      # Migration from the old empty marker needs evidence kept in this
      # binary directory, with at least one formerly owned path in this home.
      set(_evidence FALSE)
      foreach(_file IN LISTS _previous)
        string(FIND "${_file}" "${_home}/Ghidra/Processors/" _prefix)
        if(_prefix EQUAL 0)
          set(_evidence TRUE)
        endif()
      endforeach()
      if(NOT _evidence)
        message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_home}: empty marker has no prior ownership evidence in this build")
      endif()
    elseif(NOT _owner STREQUAL _identity)
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_home}: owned by another build or helper target")
    endif()
  elseif(EXISTS "${_home}")
    file(GLOB _existing LIST_DIRECTORIES true "${_home}/*")
    if(_existing OR NOT IS_DIRECTORY "${_home}")
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: OUTPUT_DIR ${_home} is not empty and has no ownership marker")
    endif()
  endif()
endfunction()

function(ghidra_sleigh_compile_specs)
  set(_opts)
  set(_one TARGET OUTPUT_DIR PROCESSORS_ROOT COMPILER OUT_VAR)
  set(_multi PROCESSORS)
  cmake_parse_arguments(ARG "${_opts}" "${_one}" "${_multi}" ${ARGN})

  if(NOT ARG_TARGET)
    message(FATAL_ERROR "ghidra_sleigh_compile_specs: TARGET is required")
  endif()
  if(NOT ARG_OUTPUT_DIR)
    message(FATAL_ERROR "ghidra_sleigh_compile_specs: OUTPUT_DIR is required")
  endif()
  _ghidra_sleigh_real_path("${ARG_OUTPUT_DIR}" ARG_OUTPUT_DIR)
  _ghidra_sleigh_real_path("${CMAKE_CURRENT_BINARY_DIR}" _build_dir)
  set(_identity "ghidra-sleigh-home-v1\nbuild=${_build_dir}\ntarget=${ARG_TARGET}\n")
  set(_manifest "${_build_dir}/${ARG_TARGET}-owned-files.txt")
  set(_home_state "${_build_dir}/${ARG_TARGET}-owned-home.txt")
  set(_previous)
  set(_previous_home)
  if(EXISTS "${_manifest}")
    file(STRINGS "${_manifest}" _previous)
  endif()
  if(EXISTS "${_home_state}")
    file(READ "${_home_state}" _previous_home)
    string(STRIP "${_previous_home}" _previous_home)
  elseif(_previous)
    # Old versions stored only absolute filenames in the build directory.
    list(GET _previous 0 _first)
    string(REGEX REPLACE "/Ghidra/Processors/.*$" "" _previous_home "${_first}")
  endif()
  foreach(_file IN LISTS _previous)
    string(FIND "${_file}" "${_previous_home}/Ghidra/Processors/" _prefix)
    if(NOT _prefix EQUAL 0 OR _file MATCHES "/\\.\\./")
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: invalid prior ownership path: ${_file}")
    endif()
    _ghidra_sleigh_real_path("${_file}" _resolved)
    if(NOT _resolved STREQUAL _file)
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: prior owned path now traverses a symlink: ${_file}")
    endif()
  endforeach()
  # Check both homes before writing markers, manifests or pruning any files.
  _ghidra_sleigh_check_home("${ARG_OUTPUT_DIR}" "${_identity}" "${_previous}")
  if(_previous_home AND NOT _previous_home STREQUAL ARG_OUTPUT_DIR)
    _ghidra_sleigh_check_home("${_previous_home}" "${_identity}" "${_previous}")
  endif()
  if(NOT ARG_PROCESSORS_ROOT)
    get_filename_component(ARG_PROCESSORS_ROOT
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../../../../Processors" ABSOLUTE)
  endif()
  if(NOT ARG_COMPILER)
    set(ARG_COMPILER sleigh_compiler)
  endif()
  if(TARGET "${ARG_COMPILER}")
    set(_compiler_cmd "$<TARGET_FILE:${ARG_COMPILER}>")
    set(_compiler_dep "${ARG_COMPILER}")
  else()
    set(_compiler_cmd "${ARG_COMPILER}")
    set(_compiler_dep "")
  endif()

  get_property(_pools GLOBAL PROPERTY JOB_POOLS)
  set(_pool_arg)
  if(_pools MATCHES "(^|;)sleigh_specs=")
    set(_pool_arg JOB_POOL sleigh_specs)
  endif()

  set(_all_sla)
  set(_owned)
  foreach(_proc IN LISTS ARG_PROCESSORS)
    set(_langdir "${ARG_PROCESSORS_ROOT}/${_proc}/data/languages")
    if(NOT IS_DIRECTORY "${_langdir}")
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: no such processor directory: ${_langdir}")
    endif()
    set(_outdir "${ARG_OUTPUT_DIR}/Ghidra/Processors/${_proc}/data/languages")

    # Options from build.gradle: sleighCompileOptions = [ '-l', "-t" ]
    set(_options)
    set(_gradle "${ARG_PROCESSORS_ROOT}/${_proc}/build.gradle")
    set(_option_dependency)
    if(EXISTS "${_gradle}")
      set(_option_dependency "${_gradle}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_gradle}")
      _ghidra_sleigh_options("${_gradle}" _options)
    endif()

    # Which .sla files do the .ldefs ask for?
    file(GLOB _ldefs CONFIGURE_DEPENDS "${_langdir}/*.ldefs")
    set(_wanted_sla)
    foreach(_ld IN LISTS _ldefs)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_ld}")
      file(READ "${_ld}" _ld_text)
      string(REGEX MATCHALL "slafile=\"[^\"]*\"" _refs "${_ld_text}")
      foreach(_r IN LISTS _refs)
        string(REGEX REPLACE "^slafile=\"|\"$" "" _r "${_r}")
        list(APPEND _wanted_sla "${_r}")
      endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _wanted_sla)

    file(GLOB _slaspecs CONFIGURE_DEPENDS "${_langdir}/*.slaspec")
    file(GLOB _sincs CONFIGURE_DEPENDS "${_langdir}/*.sinc")
    set(_proc_sla)
    foreach(_spec IN LISTS _slaspecs)
      get_filename_component(_name "${_spec}" NAME_WLE)
      if(NOT "${_name}.sla" IN_LIST _wanted_sla)
        message(STATUS "sleigh specs: ${_proc}/${_name}.slaspec is not referenced by an .ldefs, skipped")
        continue()
      endif()
      set(_out "${_outdir}/${_name}.sla")
      add_custom_command(
        OUTPUT "${_out}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${_outdir}"
        COMMAND "${_compiler_cmd}" ${_options} "${_spec}" "${_out}"
        DEPENDS ${_slaspecs} ${_sincs} ${_compiler_dep} ${_option_dependency}
        COMMENT "sleigh ${_proc}/${_name}.slaspec"
        ${_pool_arg}
        VERBATIM
      )
      list(APPEND _proc_sla "${_out}")
    endforeach()
    foreach(_wanted IN LISTS _wanted_sla)
      if(NOT "${_outdir}/${_wanted}" IN_LIST _proc_sla)
        message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_proc}: ${_wanted}: no matching generated .slaspec")
      endif()
    endforeach()
    if(NOT _proc_sla)
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: ${_proc}: no .slaspec is referenced by an .ldefs")
    endif()
    list(APPEND _all_sla ${_proc_sla})

    # Support files next to the .sla files.
    file(GLOB _support CONFIGURE_DEPENDS LIST_DIRECTORIES false "${_langdir}/*")
    list(FILTER _support EXCLUDE REGEX "\\.(slaspec|sinc|sla)$")
    foreach(_input IN LISTS _support)
      get_filename_component(_name "${_input}" NAME)
      set(_output "${_outdir}/${_name}")
      list(APPEND _owned "${_output}")
      # Each output has its own rule: new old-mtime inputs cannot hide behind
      # an already-newer shared stamp (notably with Unix Makefiles).
      add_custom_command(
        OUTPUT "${_output}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${_outdir}"
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_input}" "${_output}"
        COMMAND "${CMAKE_COMMAND}" -E touch "${_output}"
        DEPENDS "${_input}"
        COMMENT "sleigh specs: copy ${_proc}/${_name}"
        VERBATIM
      )
    endforeach()
    list(LENGTH _proc_sla _n)
    string(REPLACE ";" " " _opt_str "${_options}")
    message(STATUS "sleigh specs: ${_proc}: ${_n} spec(s), options: ${_opt_str}")
  endforeach()

  list(APPEND _owned ${_all_sla})
  foreach(_file IN LISTS _owned)
    _ghidra_sleigh_real_path("${_file}" _resolved)
    if(NOT _resolved STREQUAL _file)
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: output path traverses a symlink: ${_file}")
    endif()
    if((EXISTS "${_file}" OR IS_SYMLINK "${_file}") AND NOT _file IN_LIST _previous)
      message(FATAL_ERROR "ghidra_sleigh_compile_specs: refusing to overwrite unowned file: ${_file}")
    endif()
  endforeach()
  # Commit ownership only after all processors and destinations pass validation.
  file(MAKE_DIRECTORY "${ARG_OUTPUT_DIR}")
  file(WRITE "${ARG_OUTPUT_DIR}/.sleigh-home-owned-by-cmake" "${_identity}")
  if(_previous_home AND EXISTS "${_previous_home}/.sleigh-home-owned-by-cmake")
    file(WRITE "${_previous_home}/.sleigh-home-owned-by-cmake" "${_identity}")
  endif()
  foreach(_file IN LISTS _previous)
    if(NOT _file IN_LIST _owned)
      file(REMOVE "${_file}")
    endif()
  endforeach()
  string(REPLACE ";" "\n" _manifest_content "${_owned}")
  file(WRITE "${_manifest}" "${_manifest_content}\n")
  file(WRITE "${_home_state}" "${ARG_OUTPUT_DIR}\n")

  add_custom_target(${ARG_TARGET} ALL DEPENDS ${_owned})
  set_property(TARGET ${ARG_TARGET} PROPERTY GHIDRA_SLEIGH_HOME "${ARG_OUTPUT_DIR}")
  # Absolute paths only; no ownership metadata or internal build stamps.
  set_property(TARGET ${ARG_TARGET} PROPERTY GHIDRA_SLEIGH_INSTALLABLE_FILES "${_owned}")
  if(ARG_OUT_VAR)
    set(${ARG_OUT_VAR} "${_all_sla}" PARENT_SCOPE)
  endif()
endfunction()
