cmake_minimum_required(VERSION 3.24)
file(REAL_PATH "${WORK}" WORK)
include("${CMAKE_CURRENT_LIST_DIR}/BundledZlib.cmake")
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef id)
set(root "${WORK}/zlib-drift-${id}")
file(MAKE_DIRECTORY "${root}/cpp" "${root}/zlib")
file(COPY "${SOURCE}/../zlib/" DESTINATION "${root}/zlib")
configure_file("${SOURCE}/compression.cc" "${root}/cpp/compression.cc" COPYONLY)
ghidra_prepare_bundled_zlib("${root}/cpp" "${root}/good")
file(READ "${root}/good/BundledZlibPrefix.h" prefix)
file(READ "${root}/good/compression.cc" compression)
if(prefix MATCHES "#define (z_streamp|z_stream|internal_state|deflateInit|inflateInit) " OR NOT prefix MATCHES "#define z_errmsg ghidra_z_z_errmsg" OR
    NOT compression MATCHES "Compress::deflate" OR NOT compression MATCHES "Decompress::inflate")
  message(FATAL_ERROR "Private generation changed public type/method tokens")
endif()
file(WRITE "${root}/run.cmake" "cmake_minimum_required(VERSION 3.24)\ninclude([==[${CMAKE_CURRENT_LIST_DIR}/BundledZlib.cmake]==])\nghidra_prepare_bundled_zlib([==[${root}/cpp]==] [==[${root}/rejected]==])\n")
foreach(file zconf.h zutil.c zutil.h)
  file(APPEND "${root}/zlib/${file}" "\n/* simulated upstream drift */\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${root}/run.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(result EQUAL 0 OR NOT "${out}${err}" MATCHES "inventory drift")
    message(FATAL_ERROR "Missed ${file} inventory drift: ${out}${err}")
  endif()
  configure_file("${SOURCE}/../zlib/${file}" "${root}/zlib/${file}" COPYONLY)
endforeach()
file(APPEND "${root}/cpp/compression.cc" "\nint new_call() { return inflateEnd(0); }\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${root}/run.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(result EQUAL 0 OR NOT "${out}${err}" MATCHES "call-site inventory drift")
  message(FATAL_ERROR "Missed compression call-site drift: ${out}${err}")
endif()
message(STATUS "Bundled zlib generation and drift gates passed: ${root}")
