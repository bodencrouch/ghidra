cmake_minimum_required(VERSION 3.24)
file(REAL_PATH "${WORK}" WORK)
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef id)
set(root "${WORK}/zlib-symbol-guard-${id}")
file(MAKE_DIRECTORY "${root}")
set(flags -std=c11 -fPIC -DNO_GZIP -include "${PREFIX}" "-I${SOURCE}/../zlib")
if(SANITIZE)
  list(APPEND flags "-fsanitize=${SANITIZE}" -fno-omit-frame-pointer)
endif()
function(check_object name source accepted)
  execute_process(COMMAND "${CC}" ${flags} -c "${source}" -o "${root}/${name}.o"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Symbol fixture ${name} compilation failed: ${out}${err}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DNM=${NM}" "-DSYMBOLS=${SYMBOLS}"
    "-DOBJECTS=${root}/${name}.o" "-DC_COMPILER_ID=${C_COMPILER_ID}" "-DSANITIZE=${SANITIZE}"
    -P "${CMAKE_CURRENT_LIST_DIR}/TestBundledZlibSymbols.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(accepted)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Rejected real bundled object ${name}: ${out}${err}")
    endif()
  elseif(result EQUAL 0 OR NOT "${out}${err}" MATCHES "Unmapped bundled C global")
    message(FATAL_ERROR "Missed unexpected global ${name}: ${out}${err}")
  endif()
endfunction()
check_object(zutil "${SOURCE}/../zlib/zutil.c" TRUE)
foreach(name unknown_global _unknown_global z_errmsg ghidra_z_unknown)
  if(name STREQUAL "ghidra_z_unknown")
    # A private-looking but unaudited ODR indicator must still fail.
    file(WRITE "${root}/${name}.c" "int __odr_asan_gen_ghidra_z_unknown;\n")
  elseif(name STREQUAL "z_errmsg")
    file(WRITE "${root}/${name}.c" "#undef z_errmsg\nint z_errmsg;\n")
  else()
    file(WRITE "${root}/${name}.c" "int ${name};\n")
  endif()
  check_object("${name}" "${root}/${name}.c" FALSE)
endforeach()
# An audited name without its real private definition is not an indicator.
file(WRITE "${root}/orphan.c" "int __odr_asan_gen_ghidra_z_z_errmsg;\n")
check_object(orphan "${root}/orphan.c" FALSE)
message(STATUS "Real bundled object and unknown/unprefixed/ODR negative controls passed: ${root}")
