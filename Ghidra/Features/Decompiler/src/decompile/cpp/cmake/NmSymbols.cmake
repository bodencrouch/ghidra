# Parse nm's POSIX -P rows and normalize the extra C-symbol underscore used by
# Mach-O. The leading underscore that remains on Itanium C++ names is ABI data.
function(ghidra_parse_nm_inventory inventory is_apple out_symbols out_definitions)
  string(REPLACE "\r\n" "\n" _normalized_inventory "${inventory}")
  string(REPLACE "\n" ";" _rows "${_normalized_inventory}")
  set(_symbols)
  set(_definitions)
  foreach(_row IN LISTS _rows)
    if(_row MATCHES "^([^ \t]+)[ \t]+([A-Za-z?])([ \t].*)?$")
      set(_symbol "${CMAKE_MATCH_1}")
      set(_type "${CMAKE_MATCH_2}")
      if(is_apple AND _symbol MATCHES "^_")
        string(SUBSTRING "${_symbol}" 1 -1 _symbol)
      endif()
      list(APPEND _symbols "${_symbol}")
      if(NOT _type STREQUAL "U")
        list(APPEND _definitions "${_symbol}")
      endif()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _symbols)
  list(REMOVE_DUPLICATES _definitions)
  set(${out_symbols} "${_symbols}" PARENT_SCOPE)
  set(${out_definitions} "${_definitions}" PARENT_SCOPE)
endfunction()

function(ghidra_demangle_nm_symbols symbols cxxfilt out_symbols)
  if(NOT cxxfilt)
    message(FATAL_ERROR "A C++ demangler is required to audit native symbols")
  endif()
  if(NOT symbols)
    set(${out_symbols} "" PARENT_SCOPE)
    return()
  endif()
  # Symbol inventories can exceed the platform's argv limit. Feed the
  # demangler on stdin instead of expanding every symbol into command args.
  string(JOIN "\n" _input ${symbols})
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _id)
  set(_input_file "${CMAKE_CURRENT_BINARY_DIR}/ghidra-nm-symbols-${_id}.txt")
  file(WRITE "${_input_file}" "${_input}\n")
  execute_process(COMMAND "${cxxfilt}" INPUT_FILE "${_input_file}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
  file(REMOVE "${_input_file}")
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "C++ symbol demangling failed: ${_error}")
  endif()
  string(REPLACE "\r\n" "\n" _output "${_output}")
  string(REPLACE "\n" ";" _demangled "${_output}")
  list(REMOVE_ITEM _demangled "")
  list(LENGTH symbols _input_count)
  list(LENGTH _demangled _output_count)
  if(NOT _input_count EQUAL _output_count)
    message(FATAL_ERROR "C++ demangler changed symbol count (${_input_count} to ${_output_count})")
  endif()
  set(${out_symbols} "${_demangled}" PARENT_SCOPE)
endfunction()
