# Trusted local, sequential filesystem operations. No crash-atomic package
# replacement is promised. Called before package writes and after all rules.
cmake_minimum_required(VERSION 3.24)

function(_ghidra_install_path path)
  if(WIN32)
    string(REPLACE "\\" "/" path "${path}")
  endif()
  if(NOT IS_ABSOLUTE "${path}" OR path MATCHES "[;\n\r]" OR path MATCHES "(^|/)\\.\\.?(/|$)")
    message(FATAL_ERROR "Sleigh install: unbounded path: ${path}")
  endif()
  set(_part "${path}")
  while(TRUE)
    if(IS_SYMLINK "${_part}")
      message(FATAL_ERROR "Sleigh install: symlink path: ${_part}")
    endif()
    get_filename_component(_parent "${_part}" DIRECTORY)
    if(_parent STREQUAL _part)
      break()
    endif()
    if(EXISTS "${_parent}" AND NOT IS_DIRECTORY "${_parent}")
      message(FATAL_ERROR "Sleigh install: non-directory ancestor: ${_parent}")
    endif()
    set(_part "${_parent}")
  endwhile()
endfunction()

function(_ghidra_install_regular path)
  _ghidra_install_path("${path}")
  if(UNIX)
    find_program(_ghidra_test test REQUIRED)
    execute_process(COMMAND "${_ghidra_test}" -f "${path}" RESULT_VARIABLE _regular)
  elseif(WIN32)
    find_program(_ghidra_powershell NAMES powershell pwsh REQUIRED)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GHIDRA_INSTALL_CHECK=${path}"
      "${_ghidra_powershell}" -NoProfile -NonInteractive -Command
      "if ((Get-Item -LiteralPath $env:GHIDRA_INSTALL_CHECK -Force) -is [System.IO.FileInfo]) { exit 0 } else { exit 1 }"
      RESULT_VARIABLE _regular)
  else()
    message(FATAL_ERROR "Sleigh install: regular-file checks unsupported on this host")
  endif()
  if(NOT _regular EQUAL 0)
    message(FATAL_ERROR "Sleigh install: not a regular file: ${path}")
  endif()
endfunction()

function(_ghidra_install_suffix path)
  if(NOT path MATCHES "^Ghidra/Processors/[A-Za-z0-9_+-][A-Za-z0-9_.+-]*/data/languages/[A-Za-z0-9_+-][A-Za-z0-9_.+-]*$")
    message(FATAL_ERROR "Sleigh install: invalid ownership suffix: ${path}")
  endif()
endfunction()

if(GHIDRA_INSTALL_PHASE STREQUAL "preflight")
  if(WIN32)
    string(REPLACE "\\" "/" GHIDRA_INSTALL_DATA "${GHIDRA_INSTALL_DATA}")
  endif()
  if(IS_ABSOLUTE "${GHIDRA_INSTALL_DATA}" OR GHIDRA_INSTALL_DATA MATCHES "(^|/)\\.\\.?(/|$)|[;\n\r]" OR GHIDRA_INSTALL_DATA STREQUAL "")
    message(FATAL_ERROR "Sleigh install: data destination must be bounded and relative")
  endif()
  set(_ghidra_destdir "$ENV{DESTDIR}")
  if(WIN32)
    string(REPLACE "\\" "/" _ghidra_destdir "${_ghidra_destdir}")
    if(NOT _ghidra_destdir STREQUAL "")
      message(FATAL_ERROR "Sleigh install: DESTDIR staging is not supported on Windows")
    endif()
  endif()
  set(_ghidra_raw_prefix "${CMAKE_INSTALL_PREFIX}")
  # Validate original components before normalization: symlink/.. can resolve
  # differently in file(INSTALL) and ownership-manifest paths.
  if(_ghidra_raw_prefix STREQUAL "")
    # Generated install scripts strip / to empty. This is a valid rootfs prefix.
    set(_ghidra_logical_prefix "/")
  else()
    if(WIN32 AND _ghidra_raw_prefix MATCHES "^[A-Za-z]:$")
      # cmake_install.cmake strips the trailing slash from a drive-root prefix.
      set(_ghidra_raw_prefix "${_ghidra_raw_prefix}/")
    endif()
    if(NOT IS_ABSOLUTE "${_ghidra_raw_prefix}")
      message(FATAL_ERROR "Sleigh install: install prefix must be absolute")
    endif()
    if(_ghidra_raw_prefix MATCHES "(^|/)\\.\\.?(/|$)|[;\n\r]")
      message(FATAL_ERROR "Sleigh install: unbounded path: ${_ghidra_raw_prefix}")
    endif()
    if(_ghidra_destdir STREQUAL "")
      # For a direct install, this is the physical target path.
      _ghidra_install_path("${_ghidra_raw_prefix}")
    else()
      # Validate the path that file(INSTALL) will actually use, not ancestors
      # of the logical prefix on the build host. A staged /usr/local remains
      # valid even when the host's /usr/local is a symlink.
      _ghidra_install_path("${_ghidra_destdir}${_ghidra_raw_prefix}")
    endif()
    cmake_path(ABSOLUTE_PATH _ghidra_raw_prefix NORMALIZE OUTPUT_VARIABLE _ghidra_logical_prefix)
  endif()
  if(NOT _ghidra_destdir STREQUAL "")
    if(NOT IS_ABSOLUTE "${_ghidra_destdir}")
      message(FATAL_ERROR "Sleigh install: DESTDIR must be absolute")
    endif()
    _ghidra_install_path("${_ghidra_destdir}")
    cmake_path(ABSOLUTE_PATH _ghidra_destdir NORMALIZE OUTPUT_VARIABLE _ghidra_destdir)
  endif()
  cmake_path(GET _ghidra_destdir ROOT_PATH _ghidra_destdir_root)
  if(_ghidra_destdir STREQUAL _ghidra_destdir_root)
    # DESTDIR=/ is the ordinary, unstaged destination.
    set(_ghidra_destdir "")
  else()
    string(REGEX REPLACE "/+$" "" _ghidra_destdir "${_ghidra_destdir}")
  endif()
  set(_ghidra_prefix "${_ghidra_destdir}${_ghidra_logical_prefix}")
  cmake_path(NORMAL_PATH _ghidra_prefix OUTPUT_VARIABLE _ghidra_prefix)
  if(WIN32)
    string(REPLACE "\\" "/" _ghidra_prefix "${_ghidra_prefix}")
  endif()
  if(_ghidra_prefix STREQUAL "/")
    set(_ghidra_home "/${GHIDRA_INSTALL_DATA}")
  else()
    set(_ghidra_home "${_ghidra_prefix}/${GHIDRA_INSTALL_DATA}")
  endif()
  cmake_path(NORMAL_PATH _ghidra_home OUTPUT_VARIABLE _ghidra_home)
  if(NOT _ghidra_home STREQUAL "/" AND NOT _ghidra_home MATCHES "^[A-Za-z]:/$")
    string(REGEX REPLACE "/+$" "" _ghidra_home "${_ghidra_home}")
  endif()
  set(_ghidra_state "${_ghidra_home}/.ghidra-sleigh-install-state")
  set(_ghidra_pending "${_ghidra_state}.pending")
  _ghidra_install_path("${_ghidra_state}")
  _ghidra_install_path("${_ghidra_pending}")
  # Keep the persistent coordination lock outside both install payloads and
  # independent of TMPDIR, HOME, or a particular build tree. Key it by the
  # normalized ownership home so alternate prefix/data spellings that manage
  # the same state and language files share one lock.
  if(UNIX)
    find_program(_ghidra_id id REQUIRED)
    find_program(_ghidra_test test REQUIRED)
    execute_process(COMMAND "${_ghidra_id}" -u
      RESULT_VARIABLE _uid_result OUTPUT_VARIABLE _uid OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT _uid_result EQUAL 0 OR NOT _uid MATCHES "^[0-9]+$")
      message(FATAL_ERROR "Sleigh install: unable to determine the current user id for lock isolation")
    endif()
    # Use a fixed system temp location so login-session state and XDG_RUNTIME_DIR
    # cannot split same-user locks or remove them during an install.
    set(_ghidra_lock_base "/tmp")
    set(_ghidra_lock_directory "${_ghidra_lock_base}/.ghidra-decompiler-install-${_uid}")
    file(MAKE_DIRECTORY "${_ghidra_lock_directory}")
    if(IS_SYMLINK "${_ghidra_lock_directory}" OR NOT IS_DIRECTORY "${_ghidra_lock_directory}")
      message(FATAL_ERROR "Sleigh install: unsafe lock directory: ${_ghidra_lock_directory}")
    endif()
    execute_process(COMMAND "${_ghidra_test}" -O "${_ghidra_lock_directory}"
      RESULT_VARIABLE _lock_directory_owner)
    if(NOT _lock_directory_owner EQUAL 0)
      message(FATAL_ERROR "Sleigh install: lock directory is not owned by the current user: ${_ghidra_lock_directory}; remove this stale or squatted directory as its owner, then retry")
    endif()
    file(CHMOD "${_ghidra_lock_directory}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  elseif(WIN32)
    if(NOT DEFINED ENV{LOCALAPPDATA} OR "$ENV{LOCALAPPDATA}" STREQUAL "")
      message(FATAL_ERROR "Sleigh install: LOCALAPPDATA is required for the per-user lock directory")
    endif()
    set(_ghidra_lock_directory "$ENV{LOCALAPPDATA}/Ghidra/Decompiler/install-locks")
    file(MAKE_DIRECTORY "${_ghidra_lock_directory}")
  else()
    message(FATAL_ERROR "Sleigh install: lock directory unsupported on this host")
  endif()
  string(SHA256 _ghidra_destination_hash "${_ghidra_home}")
  set(_ghidra_lock "${_ghidra_lock_directory}/${_ghidra_destination_hash}.lock")
  file(LOCK "${_ghidra_lock}" GUARD PROCESS TIMEOUT 30 RESULT_VARIABLE _lock_result)
  if(NOT _lock_result STREQUAL "0")
    message(FATAL_ERROR "Sleigh install: prefix lock failed: ${_lock_result}")
  endif()
  if(EXISTS "${_ghidra_pending}")
    message(FATAL_ERROR "Sleigh install: incomplete prior install; inspect ${_ghidra_pending}")
  endif()
  set(_ghidra_identity "GhidraDecompiler/SleighHome/v1")
  set(_ghidra_previous)
  if(EXISTS "${_ghidra_state}")
    _ghidra_install_regular("${_ghidra_state}")
    file(READ "${_ghidra_state}" _state_text)
    if(_state_text MATCHES ";" OR NOT _state_text MATCHES "\n$")
      message(FATAL_ERROR "Sleigh install: corrupt ownership state")
    endif()
    string(REPLACE "\n" ";" _rows "${_state_text}")
    list(POP_FRONT _rows _identity)
    list(POP_BACK _rows _terminator)
    if(NOT _identity STREQUAL _ghidra_identity)
      message(FATAL_ERROR "Sleigh install: different package identity or corrupt state")
    endif()
    foreach(_row IN LISTS _rows)
      if(NOT _row MATCHES "^([0-9a-f]+) (.+)$")
        message(FATAL_ERROR "Sleigh install: corrupt ownership record")
      endif()
      set(_digest "${CMAKE_MATCH_1}")
      set(_relative "${CMAKE_MATCH_2}")
      string(LENGTH "${_digest}" _digest_size)
      if(NOT _digest_size EQUAL 64 OR _relative IN_LIST _ghidra_previous)
        message(FATAL_ERROR "Sleigh install: corrupt or duplicate ownership record")
      endif()
      _ghidra_install_suffix("${_relative}")
      _ghidra_install_path("${_ghidra_home}/${_relative}")
      if(EXISTS "${_ghidra_home}/${_relative}")
        _ghidra_install_regular("${_ghidra_home}/${_relative}")
        file(SHA256 "${_ghidra_home}/${_relative}" _actual)
        if(NOT _actual STREQUAL _digest)
          message(FATAL_ERROR "Sleigh install: modified owned file: ${_relative}")
        endif()
      endif()
      list(APPEND _ghidra_previous "${_relative}")
    endforeach()
  endif()
  set(_ghidra_desired)
  set(_ghidra_new_state "${_ghidra_identity}\n")
  foreach(_source IN LISTS GHIDRA_INSTALL_FILES)
    _ghidra_install_regular("${_source}")
    file(RELATIVE_PATH _relative "${GHIDRA_INSTALL_SOURCE_HOME}" "${_source}")
    _ghidra_install_suffix("${_relative}")
    if(_relative IN_LIST _ghidra_desired)
      message(FATAL_ERROR "Sleigh install: duplicate desired path")
    endif()
    _ghidra_install_path("${_ghidra_home}/${_relative}")
    if(EXISTS "${_ghidra_home}/${_relative}" AND NOT _relative IN_LIST _ghidra_previous)
      message(FATAL_ERROR "Sleigh install: unmanifested collision (no implicit adoption): ${_relative}")
    endif()
    file(SHA256 "${_source}" _digest)
    list(APPEND _ghidra_desired "${_relative}")
    string(APPEND _ghidra_new_state "${_digest} ${_relative}\n")
  endforeach()
  set(_ghidra_preflight_done TRUE)
elseif(GHIDRA_INSTALL_PHASE STREQUAL "commit")
  if(NOT _ghidra_preflight_done)
    message(FATAL_ERROR "Sleigh install: missing package preflight")
  endif()
  file(MAKE_DIRECTORY "${_ghidra_home}")
  # A failure after here leaves a detectable incomplete operation, not a new
  # successful state. Normal CMake archive/header writes may also be partial.
  file(WRITE "${_ghidra_pending}" "${_ghidra_new_state}")
  foreach(_relative IN LISTS _ghidra_previous)
    if(NOT _relative IN_LIST _ghidra_desired)
      file(REMOVE "${_ghidra_home}/${_relative}")
      if(EXISTS "${_ghidra_home}/${_relative}")
        message(FATAL_ERROR "Sleigh install: failed to retire ${_relative}")
      endif()
    endif()
  endforeach()
  foreach(_relative IN LISTS _ghidra_desired)
    get_filename_component(_directory "${_ghidra_home}/${_relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${_directory}")
    file(COPY_FILE "${GHIDRA_INSTALL_SOURCE_HOME}/${_relative}" "${_ghidra_home}/${_relative}" ONLY_IF_DIFFERENT)
    file(SHA256 "${_ghidra_home}/${_relative}" _written)
    file(SHA256 "${GHIDRA_INSTALL_SOURCE_HOME}/${_relative}" _source_digest)
    if(NOT _written STREQUAL _source_digest)
      message(FATAL_ERROR "Sleigh install: copy digest mismatch: ${_relative}")
    endif()
    list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${CMAKE_INSTALL_PREFIX}/${GHIDRA_INSTALL_DATA}/${_relative}")
  endforeach()
  file(RENAME "${_ghidra_pending}" "${_ghidra_state}")
else()
  message(FATAL_ERROR "Sleigh install: unknown phase")
endif()
