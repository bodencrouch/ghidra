cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/NmSymbols.cmake")
file(READ "${SYMBOLS}" symbols)
foreach(archive IN LISTS ARCHIVES)
  execute_process(COMMAND "${NM}" -g -P "${archive}" RESULT_VARIABLE result OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Bundled zlib nm failed: ${error}")
  endif()
  ghidra_parse_nm_inventory("${inventory}" "${APPLE}" archive_symbols archive_definitions)
  foreach(symbol IN LISTS archive_symbols)
    if(symbol IN_LIST symbols)
      message(FATAL_ERROR "Bundled archive contains unprefixed definition/reference: ${symbol}")
    endif()
    string(REGEX REPLACE "^z_" "" ordinary "${symbol}")
    if(symbol MATCHES "^z_" AND ordinary IN_LIST symbols)
      message(FATAL_ERROR "Bundled archive contains stock-prefixed symbol: ${symbol}")
    endif()
  endforeach()
  foreach(symbol ghidra_z_z_errmsg ghidra_z_deflate ghidra_z_inflate ghidra_bundled_deflateInit)
    if(NOT symbol IN_LIST archive_definitions)
      message(FATAL_ERROR "Bundled archive missing private definition: ${symbol}")
    endif()
  endforeach()
  if(NOT C_ONLY)
    if(NOT CXXFILT)
      message(FATAL_ERROR "Bundled zlib C++ symbol check requires CXXFILT")
    endif()
    set(cxx_symbols)
    foreach(symbol IN LISTS archive_definitions)
      if(symbol MATCHES "Compress|Decompress")
        list(APPEND cxx_symbols "${symbol}")
      endif()
    endforeach()
    execute_process(COMMAND "${CXXFILT}" ${cxx_symbols}
      RESULT_VARIABLE result OUTPUT_VARIABLE cpp ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT cpp MATCHES "ghidra::Compress::deflate\\(" OR
        NOT cpp MATCHES "ghidra::Decompress::inflate\\(" OR cpp MATCHES "ghidra::(Compress|Decompress)::ghidra_")
      message(FATAL_ERROR "Bundled archive changed public C++ compression methods: ${error}")
    endif()
  endif()
endforeach()
# Audit every C-object external definition, not only the known name table.
string(REPLACE "," ";" sanitizers "${SANITIZE}")
foreach(object IN LISTS OBJECTS)
  execute_process(COMMAND "${NM}" -g -P "${object}" RESULT_VARIABLE result OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "C object inventory failed: ${error}")
  endif()
  ghidra_parse_nm_inventory("${inventory}" "${APPLE}" object_symbols object_definitions)
  foreach(symbol IN LISTS object_definitions)
    if(symbol MATCHES "^ghidra_(z_|bundled_)")
      continue()
    endif()
    # Clang ASan emits one common registration flag and ODR indicators for
    # instrumented globals. Accept indicators only for audited private zlib
    # names actually defined in this object, never arbitrary source globals.
    if(C_COMPILER_ID MATCHES "^(Clang|AppleClang)$" AND "address" IN_LIST sanitizers)
      if(symbol STREQUAL "__asan_globals_registered")
        continue()
      endif()
      if(symbol MATCHES "^__odr_asan_gen_ghidra_z_([A-Za-z_0-9]+)$")
        set(ordinary "${CMAKE_MATCH_1}")
        if(ordinary IN_LIST symbols AND "ghidra_z_${ordinary}" IN_LIST object_definitions)
          continue()
        endif()
      endif()
    endif()
    message(FATAL_ERROR "Unmapped bundled C global: ${symbol}")
  endforeach()
endforeach()
message(STATUS "Bundled zlib definitions/references and complete C globals isolated")
