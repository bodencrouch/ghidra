cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/BuildSafety.cmake")
if(MODE STREQUAL "stage")
  ghidra_decomp_stage_datatests("${DIRECTORY}" ${SELECTED})
  return()
endif()
if(NOT SOURCE_DIR OR NOT TEST_ROOT)
  message(FATAL_ERROR "SOURCE_DIR and TEST_ROOT are required")
endif()
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef id)
set(root "${TEST_ROOT}/build-safety-${id}")
file(MAKE_DIRECTORY "${root}")
foreach(case same child sibling ancestor alias alias-child home-alias home-ancestor processor data-alias)
  set(fixture "${root}/${case}")
  set(source "${fixture}/decompile/cpp")
  file(MAKE_DIRECTORY "${source}/cmake" "${fixture}/decompile/datatests" "${fixture}/processors")
  configure_file("${SOURCE_DIR}/CMakeLists.txt" "${source}/CMakeLists.txt" COPYONLY)
  configure_file("${CMAKE_CURRENT_LIST_DIR}/BuildSafety.cmake" "${source}/cmake/BuildSafety.cmake" COPYONLY)
  file(WRITE "${fixture}/decompile/datatests/user.xml" "source fixture must survive\n")
  file(SHA256 "${source}/CMakeLists.txt" original_cmake)
  set(binary "${fixture}/build")
  set(home "${fixture}/output")
  if(case STREQUAL "same")
    set(binary "${source}")
  elseif(case STREQUAL "child")
    set(binary "${source}/new/nested")
  elseif(case STREQUAL "sibling")
    set(binary "${fixture}/decompile")
  elseif(case STREQUAL "ancestor")
    set(binary "${fixture}")
  elseif(case MATCHES "^alias")
    file(CREATE_LINK "${fixture}/decompile" "${fixture}/alias" SYMBOLIC)
    set(binary "${fixture}/alias")
    if(case STREQUAL "alias-child")
      string(APPEND binary "/new/nested")
    endif()
  elseif(case STREQUAL "home-alias")
    file(CREATE_LINK "${fixture}/decompile/datatests" "${fixture}/alias" SYMBOLIC)
    set(home "${fixture}/alias")
  elseif(case STREQUAL "home-ancestor")
    set(home "${fixture}")
  elseif(case STREQUAL "processor")
    set(binary "${fixture}/processors/build")
  elseif(case STREQUAL "data-alias")
    file(MAKE_DIRECTORY "${binary}/.ghidra-cmake")
    file(CREATE_LINK "${fixture}/decompile/datatests" "${binary}/.ghidra-cmake/datatests" SYMBOLIC)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${binary}"
    "-DGHIDRA_DECOMP_SLEIGH_HOME=${home}"
    "-DGHIDRA_DECOMP_PROCESSORS_ROOT=${fixture}/processors"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "build safety: source/output overlap")
    message(FATAL_ERROR "${case}: overlap was not rejected: ${output}${error}")
  endif()
  file(READ "${fixture}/decompile/datatests/user.xml" sentinel)
  file(SHA256 "${source}/CMakeLists.txt" after_cmake)
  if(NOT sentinel STREQUAL "source fixture must survive\n" OR NOT original_cmake STREQUAL after_cmake)
    message(FATAL_ERROR "${case}: original source fixture changed")
  endif()
  if(EXISTS "${binary}/GhidraDecompilerConfig.cmake"
      OR (NOT case STREQUAL "data-alias" AND EXISTS "${binary}/.ghidra-cmake"))
    message(FATAL_ERROR "${case}: candidate-owned output created")
  endif()
  # CMake may have created CMakeCache.txt/CMakeFiles before our guard ran.
  # They remain visible in this disposable fixture until final cleanup.
endforeach()

set(stage "${root}/stage")
file(WRITE "${root}/one.xml" "one\n")
file(WRITE "${root}/two.xml" "two\n")
ghidra_decomp_stage_datatests("${stage}" "${root}/one.xml")
file(WRITE "${stage}/user.xml" "user sentinel\n")
ghidra_decomp_stage_datatests("${stage}" "${root}/two.xml")
if(EXISTS "${stage}/one.xml" OR NOT EXISTS "${stage}/two.xml")
  message(FATAL_ERROR "Retired generated fixture was not replaced")
endif()
ghidra_decomp_stage_datatests("${stage}")
if(EXISTS "${stage}/two.xml")
  message(FATAL_ERROR "Empty selection retained a generated fixture")
endif()
file(READ "${stage}/user.xml" sentinel)
if(NOT sentinel STREQUAL "user sentinel\n")
  message(FATAL_ERROR "Unowned data was changed")
endif()

foreach(case collision directory-alias file-alias manifest-alias traversal)
  set(directory "${root}/${case}-stage")
  file(MAKE_DIRECTORY "${directory}")
  if(case STREQUAL "collision")
    file(WRITE "${directory}/one.xml" "user sentinel\n")
  elseif(case STREQUAL "directory-alias")
    file(CREATE_LINK "${stage}" "${directory}/alias" SYMBOLIC)
    string(APPEND directory "/alias/new")
  elseif(case STREQUAL "file-alias")
    file(CREATE_LINK "${root}/one.xml" "${directory}/one.xml" SYMBOLIC)
    file(WRITE "${directory}/owned-files.txt" "one.xml\n")
  elseif(case STREQUAL "manifest-alias")
    file(CREATE_LINK "${root}/one.xml" "${directory}/owned-files.txt" SYMBOLIC)
  elseif(case STREQUAL "traversal")
    file(WRITE "${directory}/owned-files.txt" "../one.xml\n")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=stage "-DDIRECTORY=${directory}"
    "-DSELECTED=${root}/one.xml" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "data staging:")
    message(FATAL_ERROR "${case}: unsafe staging accepted: ${output}${error}")
  endif()
  file(READ "${root}/one.xml" sentinel)
  if(NOT sentinel STREQUAL "one\n")
    message(FATAL_ERROR "${case}: source changed")
  endif()
  if(case STREQUAL "collision")
    file(READ "${directory}/one.xml" sentinel)
    if(NOT sentinel STREQUAL "user sentinel\n")
      message(FATAL_ERROR "Staging collision changed user file")
    endif()
  endif()
endforeach()
file(REMOVE_RECURSE "${root}")
message(STATUS "Build overlap and owned data staging regressions passed")
