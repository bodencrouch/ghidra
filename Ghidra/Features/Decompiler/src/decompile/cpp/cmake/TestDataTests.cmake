cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/RunDataTests.cmake")
if(DEFINED CASE)
  set(output "Total tests applied = 2\nTotal passing tests = 2\n")
  set(result 0)
  if(CASE STREQUAL "zero")
    set(output "Total tests applied = 0\nTotal passing tests = 0\n")
  elseif(CASE STREQUAL "failure")
    string(APPEND output "Failures: malformed input\n")
  elseif(CASE STREQUAL "mismatch")
    set(output "Total tests applied = 2\nTotal passing tests = 1\n")
  elseif(CASE STREQUAL "missing")
    set(output "No summary\n")
  elseif(CASE STREQUAL "duplicate")
    string(APPEND output "${output}")
  elseif(CASE STREQUAL "exit")
    set(result 1)
  endif()
  ghidra_decomp_check_data_result("${CASE}" "${result}" "${output}")
  return()
endif()

foreach(case valid zero failure mismatch missing duplicate exit)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(case STREQUAL "valid")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Valid summary rejected: ${output}${error}")
    endif()
  elseif(result EQUAL 0 OR NOT error MATCHES "data test ${case}")
    message(FATAL_ERROR "Bad summary ${case} accepted or wrong failure: ${output}${error}")
  endif()
endforeach()
if(NOT BINARY OR NOT TEST_ROOT OR NOT SOURCE_DIR OR NOT SLEIGH_HOME)
  message(FATAL_ERROR "BINARY, TEST_ROOT, SOURCE_DIR and SLEIGH_HOME are required")
endif()
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef id)
set(root "${TEST_ROOT}/data-guard-${id}")
file(MAKE_DIRECTORY "${root}")
file(READ "${SOURCE_DIR}/../datatests/skipnext2.xml" valid)
foreach(case malformed missing-language zero-cases valid)
  set(fixture "${valid}")
  if(case STREQUAL "malformed")
    set(fixture "<decompilertest><unknown/></decompilertest>")
  elseif(case STREQUAL "missing-language")
    string(REPLACE "Toy:BE:32:builder.align2:default" "Missing:BE:32:default:default" fixture "${fixture}")
  elseif(case STREQUAL "zero-cases")
    string(REGEX REPLACE "<stringmatch[^>]*>[^<]*</stringmatch>" "" fixture "${fixture}")
  endif()
  # A valid Toy fixture needs its actual generated SLA. Negative cases run
  # even in configurations with no specs; summary validation is unconditional.
  if(case MATCHES "^(valid|zero-cases)$" AND NOT EXISTS "${SLEIGH_HOME}/Ghidra/Processors/Toy/data/languages/toy_builder_be_align2.sla")
    message(STATUS "data guard: ${case} Toy execution unavailable for this spec selection")
    continue()
  endif()
  file(WRITE "${root}/fixture.xml" "${fixture}")
  file(WRITE "${root}/owned-files.txt" "fixture.xml\n")
  if(case MATCHES "^(malformed|missing-language)$")
    execute_process(COMMAND "${BINARY}" -sleighpath "${SLEIGH_HOME}"
      -path "${root}" datatests fixture.xml
      RESULT_VARIABLE raw_result OUTPUT_VARIABLE raw_output ERROR_VARIABLE raw_error)
    if(NOT raw_result EQUAL 0 OR NOT raw_output MATCHES "Failures:")
      message(FATAL_ERROR "Expected legacy false-green ${case} fixture: ${raw_result}\n${raw_output}${raw_error}")
    endif()
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DBINARY=${BINARY}"
    "-DDATA_DIR=${root}" "-DSLEIGH_HOME=${SLEIGH_HOME}"
    -P "${CMAKE_CURRENT_LIST_DIR}/RunDataTests.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(case STREQUAL "valid")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Valid native fixture rejected: ${output}${error}")
    endif()
  elseif(result EQUAL 0 OR NOT error MATCHES "data test fixture.xml")
    message(FATAL_ERROR "Native ${case} was not rejected: ${output}${error}")
  endif()
endforeach()
foreach(selection "" "absent.xml")
  file(WRITE "${root}/owned-files.txt" "${selection}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DBINARY=${BINARY}"
    "-DDATA_DIR=${root}" "-DSLEIGH_HOME=${SLEIGH_HOME}"
    -P "${CMAKE_CURRENT_LIST_DIR}/RunDataTests.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "data tests: (zero selected|missing or unsafe)")
    message(FATAL_ERROR "Empty/missing fixture selection accepted: ${output}${error}")
  endif()
endforeach()
file(REMOVE_RECURSE "${root}")
message(STATUS "Data test summary and native fixture guard regressions passed")
