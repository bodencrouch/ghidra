cmake_minimum_required(VERSION 3.24)

function(ghidra_decomp_check_data_result name result output)
  if(NOT result STREQUAL "0" OR output MATCHES "Failures:|Error parsing |Error executing |Execution failed for ")
    message(FATAL_ERROR "data test ${name} failed (rc=${result}):\n${output}")
  endif()
  string(REGEX MATCHALL "Total tests applied = [0-9]+" applied_lines "${output}")
  string(REGEX MATCHALL "Total passing tests = [0-9]+" passing_lines "${output}")
  list(LENGTH applied_lines applied_count)
  list(LENGTH passing_lines passing_count)
  if(NOT applied_count EQUAL 1 OR NOT passing_count EQUAL 1)
    message(FATAL_ERROR "data test ${name}: missing or ambiguous result summary:\n${output}")
  endif()
  string(REGEX REPLACE ".*= " "" applied "${applied_lines}")
  string(REGEX REPLACE ".*= " "" passing "${passing_lines}")
  if(applied LESS 1 OR NOT applied EQUAL passing)
    message(FATAL_ERROR "data test ${name}: zero effective cases or failed assertions (${passing}/${applied}):\n${output}")
  endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT BINARY OR NOT DATA_DIR OR NOT SLEIGH_HOME)
    message(FATAL_ERROR "BINARY, DATA_DIR and SLEIGH_HOME are required")
  endif()
  file(STRINGS "${DATA_DIR}/owned-files.txt" tests)
  if(NOT tests)
    message(FATAL_ERROR "data tests: zero selected fixtures")
  endif()
  foreach(test IN LISTS tests)
    if(NOT test MATCHES "^[A-Za-z0-9_.+-]+\\.xml$" OR NOT EXISTS "${DATA_DIR}/${test}")
      message(FATAL_ERROR "data tests: missing or unsafe fixture: ${test}")
    endif()
    # Per-fixture summaries prevent a zero-case file hiding among valid ones.
    execute_process(COMMAND "${BINARY}" -sleighpath "${SLEIGH_HOME}"
      -path "${DATA_DIR}" datatests "${test}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    ghidra_decomp_check_data_result("${test}" "${result}" "${output}\n${error}")
    message(STATUS "data test ${test}: passed")
  endforeach()
endif()
