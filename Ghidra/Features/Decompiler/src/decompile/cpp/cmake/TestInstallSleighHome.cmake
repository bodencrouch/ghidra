function(snapshot output)
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE "${prefix}/*" "${prefix}/.*")
  list(SORT files)
  set(text "")
  foreach(file IN LISTS files)
    if(IS_SYMLINK "${file}")
      file(READ_SYMLINK "${file}" hash)
    else()
      file(SHA256 "${file}" hash)
    endif()
    string(APPEND text "${file}:${hash}\n")
  endforeach()
  set(${output} "${text}" PARENT_SCOPE)
endfunction()

function(install expect)
  set(files "")
  foreach(path IN LISTS ARGN)
    list(APPEND files "${source}/${path}")
  endforeach()
  set(script "set(CMAKE_INSTALL_PREFIX [==[${prefix}]==])\nset(GHIDRA_INSTALL_DATA [==[${data}]==])\nset(GHIDRA_INSTALL_SOURCE_HOME [==[${source}]==])\nset(GHIDRA_INSTALL_FILES [==[${files}]==])\nset(GHIDRA_INSTALL_PHASE preflight)\ninclude([==[${module}]==])\n")
  # The sentinel stands for an archive/header write. Failed preflight must
  # precede it; a component-only install must not commit language selection.
  string(APPEND script "file(WRITE [==[$ENV{DESTDIR}${prefix}/archive-sentinel]==] [==[package replacement]==])\n")
  if(NOT component_only)
    string(APPEND script "set(GHIDRA_INSTALL_PHASE commit)\ninclude([==[${module}]==])\n")
  endif()
  file(WRITE "${root}/run.cmake" "${script}")
  snapshot(before)
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${root}/run.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(expect STREQUAL "pass")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Install unexpectedly failed: ${out}\n${err}")
    endif()
  else()
    if(result EQUAL 0 OR NOT "${out}\n${err}" MATCHES "${expect}")
      message(FATAL_ERROR "Expected ${expect}, got ${result}: ${out}\n${err}")
    endif()
    snapshot(after)
    if(NOT before STREQUAL after)
      message(FATAL_ERROR "Failed preflight changed package content/state")
    endif()
  endif()
endfunction()

