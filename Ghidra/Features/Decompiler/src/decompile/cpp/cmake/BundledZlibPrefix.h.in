/* Private C-only preinclude. Never installed or applied to C++ sources. */
#if defined(__cplusplus) || defined(Z_PREFIX) || defined(Z_PREFIX_SET) || defined(ZLIB_DLL) || defined(_WIN32_WCE)
#error Unsupported bundled zlib language/prefix/DLL/WinCE configuration
#endif
#include "@GHIDRA_ZLIB_SOURCE@/zconf.h"
/* zutil.h otherwise defines these names as ordinary memcpy-family macros.
 * Reject the legacy no-memcpy branch instead of redefining those macros. */
#if !defined(STDC) || defined(NO_MEMCPY) || defined(Z_SOLO) || defined(pyr) || defined(SMALL_MEDIUM)
#error Unsupported bundled zlib no-memcpy configuration
#endif
@GHIDRA_ZLIB_MAP@
