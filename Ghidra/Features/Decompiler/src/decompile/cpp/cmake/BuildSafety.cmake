# Checks are read-only and can run before project() performs compiler probes.
function(ghidra_decomp_real_path path result)
  # ABSOLUTE and pre-CMP0152 REAL_PATH normalize '..' before following
  # symlinks. Walk components instead: alias/.. means the target's parent.
  set(absolute "${path}")
  if(WIN32)
    string(REPLACE "\\" "/" absolute "${absolute}")
  endif()
  if(absolute MATCHES ";")
    message(FATAL_ERROR "build safety: unsupported semicolon in path: ${absolute}")
  endif()
  cmake_path(IS_ABSOLUTE absolute is_absolute)
  if(NOT is_absolute)
    set(absolute "${CMAKE_CURRENT_BINARY_DIR}/${absolute}")
  endif()
  cmake_path(GET absolute ROOT_PATH canonical)
  cmake_path(GET absolute RELATIVE_PART relative)
  string(REPLACE "/" ";" components "${relative}")
  foreach(component IN LISTS components)
    if(component STREQUAL "")
      continue()
    endif()
    if(component STREQUAL "." OR component STREQUAL "..")
      # A missing/non-directory prefix has no filesystem traversal meaning;
      # do not guess how a later write command might normalize it.
      if(NOT IS_DIRECTORY "${canonical}")
        message(FATAL_ERROR "build safety: ambiguous traversal through ${canonical}")
      endif()
      if(component STREQUAL "..")
        get_filename_component(canonical "${canonical}" DIRECTORY)
      endif()
    else()
      if(EXISTS "${canonical}" AND NOT IS_DIRECTORY "${canonical}")
        message(FATAL_ERROR "build safety: non-directory path component: ${canonical}")
      endif()
      cmake_path(APPEND canonical "${component}")
      if(IS_SYMLINK "${canonical}" AND NOT EXISTS "${canonical}")
        message(FATAL_ERROR "build safety: dangling symlink: ${canonical}")
      endif()
      if(EXISTS "${canonical}")
        file(REAL_PATH "${canonical}" canonical)
      endif()
    endif()
  endforeach()
  set(${result} "${canonical}" PARENT_SCOPE)
endfunction()

function(ghidra_decomp_reject_overlap output source)
  ghidra_decomp_real_path("${output}" canonical_output)
  ghidra_decomp_real_path("${source}" canonical_source)
  cmake_path(IS_PREFIX canonical_source "${canonical_output}" NORMALIZE in_source)
  cmake_path(IS_PREFIX canonical_output "${canonical_source}" NORMALIZE contains_source)
  if(in_source OR contains_source)
    message(FATAL_ERROR "build safety: source/output overlap: ${canonical_source} and ${canonical_output}")
  endif()
endfunction()

# Own individual staged XML files, never the surrounding directory contents.
# Refuse symlink redirection and collisions before performing any write/prune.
function(ghidra_decomp_stage_datatests directory)
  ghidra_decomp_real_path("${directory}" actual)
  get_filename_component(expected "${directory}" ABSOLUTE)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "data staging: symlink redirects ${expected}")
  endif()
  set(manifest "${directory}/owned-files.txt")
  if(IS_SYMLINK "${manifest}")
    message(FATAL_ERROR "data staging: symlink manifest")
  endif()
  set(previous)
  if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" previous)
  endif()
  set(selected)
  foreach(source IN LISTS ARGN)
    get_filename_component(name "${source}" NAME)
    list(APPEND selected "${name}")
  endforeach()
  foreach(name IN LISTS previous selected)
    if(NOT name MATCHES "^[A-Za-z0-9_.+-]+\\.xml$" OR IS_SYMLINK "${directory}/${name}" OR IS_DIRECTORY "${directory}/${name}")
      message(FATAL_ERROR "data staging: unsafe owned filename: ${name}")
    endif()
  endforeach()
  foreach(name IN LISTS selected)
    if(EXISTS "${directory}/${name}" AND NOT name IN_LIST previous)
      message(FATAL_ERROR "data staging: refusing to overwrite unowned file: ${name}")
    endif()
  endforeach()
  file(MAKE_DIRECTORY "${directory}")
  foreach(name IN LISTS previous)
    if(NOT name IN_LIST selected)
      file(REMOVE "${directory}/${name}")
    endif()
  endforeach()
  foreach(source IN LISTS ARGN)
    get_filename_component(name "${source}" NAME)
    configure_file("${source}" "${directory}/${name}" COPYONLY)
  endforeach()
  list(JOIN selected "\n" content)
  file(WRITE "${manifest}" "${content}\n")
endfunction()
