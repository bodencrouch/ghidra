# Configure-only package contract probe: no engine or SLEIGH build.
cmake_minimum_required(VERSION 3.24)
if(NOT SOURCE_DIR OR NOT TEST_ROOT OR NOT CXX OR NOT GENERATOR)
  message(FATAL_ERROR "SOURCE_DIR, TEST_ROOT, GENERATOR and native GNU/Clang CXX are required")
endif()
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0 OR "${output}${error}" MATCHES "CMake (Warning|Deprecation)")
    message(FATAL_ERROR "Command failed or warned: ${ARGV}\n${output}${error}")
  endif()
endfunction()
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef id)
set(root "${TEST_ROOT}/header-contract-${id}")
file(MAKE_DIRECTORY "${root}/no-bfd")
file(WRITE "${root}/no-bfd/bfd.h" "#error BFD headers must not be required by signature support\n")
foreach(console ON OFF)
  foreach(local_zlib ON OFF)
    set(build "${root}/${console}-${local_zlib}")
    set(prefix "${build}/installed")
    run("${CMAKE_COMMAND}" -S "${SOURCE_DIR}" -B "${build}" -G "${GENERATOR}"
      "-DCMAKE_CXX_COMPILER=${CXX}" "-DCMAKE_INSTALL_PREFIX=${prefix}"
      -DGHIDRA_DECOMP_BUILD_TESTS=OFF -DGHIDRA_DECOMP_BUILD_TOOLS=OFF
      -DGHIDRA_DECOMP_SPEC_PROCESSORS= -DGHIDRA_DECOMP_CPUI_DEBUG=ON
      "-DGHIDRA_DECOMP_CONSOLE=${console}" "-DGHIDRA_DECOMP_LOCAL_ZLIB=${local_zlib}")
    run("${CMAKE_COMMAND}" --install "${build}" --component Headers)
    set(include "${prefix}/include/ghidra/decompiler")
    foreach(omitted ghidra_arch ghidra_context ghidra_process ghidra_translate inject_ghidra
        loadimage_ghidra typegrp_ghidra database_ghidra cpool_ghidra comment_ghidra
        string_ghidra signature_ghidra bfd_arch loadimage_bfd slgh_compile slghparse)
      if(EXISTS "${include}/${omitted}.hh")
        message(FATAL_ERROR "Unsupported installed header: ${omitted}.hh")
      endif()
    endforeach()
    foreach(required analyzesigs codedata)
      if(NOT EXISTS "${include}/${required}.hh")
        message(FATAL_ERROR "Missing console declaration closure: ${required}.hh")
      endif()
    endforeach()
    file(GLOB headers RELATIVE "${include}" "${include}/*.hh" "${include}/*.h")
    set(unit "")
    foreach(header IN LISTS headers)
      string(APPEND unit "#include \"${header}\"\n")
    endforeach()
    string(APPEND unit "#if defined(LINUX) || defined(_LINUX) || defined(WINDOWS) || defined(_WINDOWS)\n#error broad platform macro leaked\n#endif\nint main() { return 0; }\n")
    file(WRITE "${build}/headers.cc" "${unit}")
    set(definitions -DCPUI_DEBUG)
    if(console AND UNIX)
      list(APPEND definitions -D__TERMINAL__)
    endif()
    if(local_zlib)
      list(APPEND definitions -DLOCAL_ZLIB)
    endif()
    run("${CXX}" -std=c++11 -fsyntax-only ${definitions}
      "-I${root}/no-bfd" "-I${include}" "${build}/headers.cc")
    if(console)
      run("${CXX}" -std=c++11 -fsyntax-only ${definitions}
        "-I${root}/no-bfd" "${SOURCE_DIR}/analyzesigs.cc")
    endif()
    file(GLOB_RECURSE exports "${build}/CMakeFiles/Export/*/GhidraDecompilerTargets.cmake")
    foreach(export IN LISTS exports)
      file(READ "${export}" text)
      if(text MATCHES "INTERFACE_COMPILE_DEFINITIONS[^\n]*(LINUX|WINDOWS)" OR NOT text MATCHES "INTERFACE_COMPILE_DEFINITIONS[^\n]*CPUI_DEBUG")
        message(FATAL_ERROR "Incorrect exported macro contract: ${export}")
      endif()
      if(local_zlib AND NOT text MATCHES "INTERFACE_COMPILE_DEFINITIONS[^\n]*LOCAL_ZLIB")
        message(FATAL_ERROR "Missing public LOCAL_ZLIB")
      endif()
      if(console AND UNIX AND NOT text MATCHES "INTERFACE_COMPILE_DEFINITIONS[^\n]*__TERMINAL__")
        message(FATAL_ERROR "Missing public __TERMINAL__")
      endif()
    endforeach()
    if(NOT exports)
      message(FATAL_ERROR "No generated package export found")
    endif()
    message(STATUS "Installed headers and macro contract passed: console=${console}, local_zlib=${local_zlib}")
  endforeach()
endforeach()
file(REMOVE_RECURSE "${root}")
